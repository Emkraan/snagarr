.DS_Store

# Python
__pycache__/
*.pyc

# Environment
.env
.env.*
# Ship the placeholder template (no real secrets); gitignore has no inline comments.
!.env.example
.venv/

# Local data volume (a local ./config dir is never committed)
config/

# Terraform state and cache
*.tfstate*
terraform/.terraform/

# Build artifacts
dist/
*.egg-info/

# Runtime-generated web instance list
frontend/static/data/app_instances.json
