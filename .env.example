# Snagarr environment variables. Copy to .env and fill in as needed.
# None are strictly required to boot with defaults, but SECRET_KEY MUST be set
# to a strong random value for any non-local / authenticated deployment.

# Web server bind + port
FLASK_HOST=0.0.0.0
PORT=9705

# Timezone (IANA name), affects scheduling + log timestamps
TZ=UTC

# Flask session signing key. Generate a strong value, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If unset, a key is generated and persisted under /config/user on first run.
SECRET_KEY=

# Set to true only for local development (enables the Flask dev server).
DEBUG=false

# --- Single sign-on bootstrap (optional; Entra ID / OIDC) ---
# SSO is normally configured in the UI (Settings > Single sign-on). These vars
# only SEED a single Microsoft Entra provider on a fresh install (read once, when
# no providers exist yet); the on-disk store is authoritative afterward.
# Provide the values as read-only mounted files and point these at them.
# Never put the secret values themselves in this file or in compose env.
# OIDC_TENANT_ID_FILE=/run/secrets/oidc_tenant_id
# OIDC_CLIENT_ID_FILE=/run/secrets/oidc_client_id
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
